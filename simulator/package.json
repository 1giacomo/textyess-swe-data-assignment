{
  "name": "shopify-webhook-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Simulates Shopify webhook traffic for the SWE Data home assignment.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "start": "tsx src/index.ts",
    "simulate": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "stress": "tsx src/index.ts --workload stress",
    "steady": "tsx src/index.ts --rps 5 --topics orders,products,customers",
    "examples": "tsx scripts/generate-examples.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.3",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.5"
  }
}
